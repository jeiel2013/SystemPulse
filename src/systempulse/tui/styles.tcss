Screen {
    background: #111827;
    color: #e5e7eb;
}

Header {
    background: #172335;
    color: #e5e7eb;
}

Footer {
    background: #172335;
    color: #cbd5e1;
}

#body {
    width: 100%;
    height: 1fr;
    padding: 1 2;
}

#status-line {
    height: 2;
    color: #7dd3fc;
    text-style: bold;
}

#summary {
    layout: horizontal;
    width: 100%;
    height: 8;
}

.metric-card {
    width: 1fr;
    height: 8;
    border: round #334155;
    background: #1b293b;
    color: #e5e7eb;
    padding: 1 2;
    margin-right: 1;
    text-style: bold;
}

#cpu-history {
    height: 5;
    margin-top: 1;
    border: round #334155;
    background: #1b293b;
    padding: 1 2;
    color: #93c5fd;
}

#process-heading, #memory-process-heading {
    height: 2;
    margin-top: 1;
    color: #e5e7eb;
    text-style: bold;
}

#top-processes, #top-memory-processes {
    height: 13;
    border: round #334155;
    background: #1b293b;
}

#collector-line {
    height: 2;
    margin-top: 1;
    color: #94a3b8;
}

.compact #body {
    padding: 0 1;
}

.compact #summary {
    layout: vertical;
    height: 18;
}

.compact .metric-card {
    width: 100%;
    height: 6;
    margin-right: 0;
    padding: 0 1;
}

.short #body {
    padding: 0 1;
}

.short #status-line {
    height: 1;
}

.short #summary {
    height: 6;
}

.short .metric-card {
    height: 6;
    padding: 0 1;
}

.short #cpu-history {
    height: 4;
    margin-top: 0;
    padding: 0 1;
}

.short #process-heading, .short #memory-process-heading {
    height: 1;
    margin-top: 0;
}

.short #top-processes, .short #top-memory-processes {
    height: 9;
}

.short #collector-line {
    height: 1;
    margin-top: 0;
}

.compact.short #summary {
    height: 18;
}

#process-explorer {
    display: none;
    width: 100%;
    height: 1fr;
    padding: 1 2;
}

.show-processes #body {
    display: none;
}

.show-system #body {
    display: none;
}

.show-processes #process-explorer {
    display: block;
}

#system-view {
    display: none;
    width: 100%;
    height: 1fr;
    padding: 1 2;
}

.show-system #system-view {
    display: block;
}

#system-heading {
    height: 2;
    color: #7dd3fc;
    text-style: bold;
}

#host-facts, #hardware-facts, #gpu-facts {
    width: 100%;
    height: auto;
    min-height: 5;
    border: round #334155;
    background: #1b293b;
    padding: 1 2;
    margin-bottom: 1;
}

.compact #system-view {
    padding: 0 1;
}

#process-explorer-heading {
    height: 2;
    color: #7dd3fc;
    text-style: bold;
}

#process-search {
    width: 100%;
    margin-bottom: 1;
}

#process-table {
    width: 100%;
    height: 1fr;
    border: round #334155;
    background: #1b293b;
}

#process-explorer-hint {
    height: 2;
    color: #94a3b8;
}

.compact #process-explorer {
    padding: 0 1;
}

ProcessDetailsScreen {
    align: center middle;
    background: #000000 60%;
}

#detail-dialog {
    width: 90%;
    max-width: 90;
    height: 80%;
    max-height: 22;
    border: round #7dd3fc;
    background: #1b293b;
    padding: 1 2;
}

#detail-heading {
    height: 2;
    color: #7dd3fc;
    text-style: bold;
}

#detail-scroll {
    height: 1fr;
}

#detail-hint {
    height: 1;
    color: #94a3b8;
}
